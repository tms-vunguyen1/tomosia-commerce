generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One role, no permissions field — every merchant account has equal access
// to the portal (see SPEC-merchant-login.md).
model MerchantUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  sessions MerchantSession[]
}

// The opaque session token IS the primary key — the cookie carries this
// value directly, so a lookup is a single indexed read.
model MerchantSession {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user MerchantUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
