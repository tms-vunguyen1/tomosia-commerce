# Copy to merchant-agent/.env and fill in every value marked REQUIRED. Nothing here
# belongs in git.

# -- Anthropic --------------------------------------------------------- REQUIRED --
ANTHROPIC_API_KEY=

# -- The storefront's admin API ------------------------------------------------- --
# The Next.js app. Every Shopify Admin API call (listings, pricing, inventory) goes
# through its internal API, so this service holds no Shopify credential of its own.
# Running in Docker with the app on the host: http://host.docker.internal:3000
MERCHANT_STOREFRONT_API_URL=http://localhost:3000                       # REQUIRED

# The shared secret for the two internal hops: the Next.js session route calling this
# service, and this service calling the Next.js internal API. Set the SAME value in
# ../.env, or neither side authenticates the other.
MERCHANT_ASSISTANT_INTERNAL_TOKEN=                                       # REQUIRED

# -- This deployment ------------------------------------------------------------ --
STORE_NAME=Commerceplate                                                 # REQUIRED
MERCHANT_ASSISTANT_NAME=the merchant assistant                           # REQUIRED
# A deployment-wide constant: one store, no multi-tenant scoping. Stamped on every
# staged/applied change's session context.
MERCHANT_ID=tomosia                                                      # REQUIRED

# Host names the service answers to (same reasoning as the shopping agent's).
MERCHANT_ASSISTANT_ALLOWED_HOSTS=localhost,127.0.0.1,api

# Stock at or below this count is a low-stock alert. Shopify has no reorder-threshold
# field reachable with this app's scopes, so it is a flat per-store number.
MERCHANT_LOW_STOCK_THRESHOLD=10

# An order unfulfilled longer than this many days is a "delayed" order issue
# (get_order_issues) — the only OrderIssue kind derivable from order fields alone.
MERCHANT_DELAYED_ORDER_DAYS=3

# -- Storage (safe default; docker compose overrides it for the container) ------
# REDIS_URL=redis://localhost:6379/0

# -- Optional (safe defaults) -----------------------------------------------------
# MERCHANT_ASSISTANT_LOG_LEVEL=INFO
# MERCHANT_ASSISTANT_SESSION_STORE=redis   # "memory" is for the tests
