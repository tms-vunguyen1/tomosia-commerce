# Copy to shopping-agent/.env and fill in every value marked REQUIRED. Nothing here
# belongs in git.
#
# REQUIRED variables raise at startup, naming themselves, when unset: each one names a
# credential, an external address, or a brand string, so a default would let a
# misconfigured deployment start and quietly talk to the wrong system. The rest below
# have defaults because getting them wrong fails loud (a bad host list or memory path
# breaks obviously) rather than silently.

# -- Anthropic --------------------------------------------------------- REQUIRED --
ANTHROPIC_API_KEY=

# -- The storefront ------------------------------------------------------------- --
# The Next.js app. Every catalogue, cart, customer and policy read goes through its
# internal API, so this service holds no Shopify credential of its own.
# Running in Docker with the app on the host: http://host.docker.internal:3000
STOREFRONT_API_URL=http://localhost:3000                                # REQUIRED

# The shared secret for the two internal hops: the Next.js session route calling this
# service, and this service calling the Next.js internal API. Set the SAME value in
# ../.env, or neither side authenticates the other.
ASSISTANT_INTERNAL_TOKEN=                                                # REQUIRED

# -- This deployment ------------------------------------------------------------ --
# The brand the prompt is written in; it is part of what the model is told.
STORE_NAME=Commerceplate                                                 # REQUIRED
ASSISTANT_NAME=the Commerceplate assistant                               # REQUIRED

# Host names the service answers to. Anything else is refused (fails loud: the
# middleware then rejects every request, Next.js included), so the default below —
# loopback plus the compose service name — is safe to leave as is for either way this
# service is documented to run.
ASSISTANT_ALLOWED_HOSTS=localhost,127.0.0.1,api

# -- Storage (safe default; docker compose overrides it for the container) ------
# A wrong value here fails loud on the first Redis command, not silently.
# REDIS_URL=redis://localhost:6379/0

# -- Optional (safe defaults) -----------------------------------------------------
# ASSISTANT_LOG_LEVEL=INFO
# ASSISTANT_SESSION_STORE=redis   # "memory" is for the tests: a restart loses sessions
