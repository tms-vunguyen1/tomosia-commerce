# Shopify Store Configuration
SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"

# Storefront API Tokens (Headless Sales Channel / Custom App)
# For server-side/server-to-server queries - REQUIRED
SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN=""

# For client-side/browser queries (optional - if doing client-side fetching)
SHOPIFY_STOREFRONT_PUBLIC_ACCESS_TOKEN=""

# Revalidation Secret (for webhook-based cache revalidation)
# Get this from your Headless channel API credentials or webhook settings
SHOPIFY_REVALIDATION_SECRET=""
# Shopping Assistant (the Python service in shopping-agent/)
# Where the agent service listens. The browser never reaches it: every call goes
# through this app's /api/assistant routes.
ASSISTANT_API_URL="http://localhost:8000"

# Shared secret for the two internal hops — this app calling the agent's session
# route, and the agent calling /api/internal/assistant back. Set the SAME value in
# shopping-agent/.env. Required in production: without it the internal routes refuse.
ASSISTANT_INTERNAL_TOKEN=""

# Merchant portal login (Postgres via Prisma — see docker-compose.yml).
# docker compose up -d postgres, then npx prisma migrate dev.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tomosia_merchant"
