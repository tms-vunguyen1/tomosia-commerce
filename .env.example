# Local dev values. For production (Vercel + Render), see docs/deployment.md —
# DATABASE_URL, ASSISTANT_API_URL and MERCHANT_ASSISTANT_API_URL all point
# somewhere different there.

# Shopify Store Configuration
SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"

# Storefront API Tokens (Headless Sales Channel / Custom App)
# For server-side/server-to-server queries - REQUIRED
SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN=""

# For client-side/browser queries (optional - if doing client-side fetching)
SHOPIFY_STOREFRONT_PUBLIC_ACCESS_TOKEN=""

# Revalidation Secret (for webhook-based cache revalidation)
# Get this from your Headless channel API credentials or webhook settings
SHOPIFY_REVALIDATION_SECRET=""
# Shopping Assistant (the Python service in shopping-agent/)
# Where the agent service listens. The browser never reaches it: every call goes
# through this app's /api/assistant routes.
ASSISTANT_API_URL="http://localhost:8000"

# Shared secret for the two internal hops — this app calling the agent's session
# route, and the agent calling /api/internal/assistant back. Set the SAME value in
# shopping-agent/.env. Required in production: without it the internal routes refuse.
ASSISTANT_INTERNAL_TOKEN=""

# Merchant portal login (Postgres via Prisma — see docker-compose.yml).
# docker compose up -d postgres, then npx prisma migrate dev.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tomosia_merchant"

# Merchant Agent's Admin API access (client credentials grant — Dev Dashboard app,
# not a static token). Create the app at https://dev.shopify.com, set its
# distribution to "Custom" (not left unset/"Public" — this is what gates Order
# object and ShopifyQL access; it cannot be changed after the fact), install it
# on this store via the Custom-distribution install link, then copy its Client
# ID/Secret from the app's API credentials page. Scopes needed: read_products,
# write_products, read_inventory, write_inventory, read_locations, read_orders,
# write_orders, read_reports (traffic/conversion via ShopifyQL). The app and this
# store must be in the same Dev Dashboard organization.
SHOPIFY_ADMIN_CLIENT_ID=""
SHOPIFY_ADMIN_CLIENT_SECRET=""

# Merchant Agent (the Python service in merchant-agent/)
# Where the agent service listens. The browser never reaches it: every call goes
# through this app's /merchant/api routes.
MERCHANT_ASSISTANT_API_URL="http://localhost:8100"

# Shared secret for the two internal hops — this app calling the agent's session
# route, and the agent calling /api/internal/merchant back. Set the SAME value in
# merchant-agent/.env. Required in production: without it the internal routes refuse.
MERCHANT_ASSISTANT_INTERNAL_TOKEN=""
